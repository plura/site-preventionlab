<mj-attributes>
	<mj-all font-family="{{BRAND_FONT}}" />
	<mj-text font-size="14px" line-height="1.7" color="{{BRAND_INK}}" />
	<mj-body width="560px" background-color="{{BRAND_FRAME}}" />

	<mj-class name="page-frame" background-color="{{BRAND_FRAME}}" padding="48px 16px" />
	<mj-class name="header-pad" background-color="{{BRAND_FRAME}}" padding="0" />
	<mj-class name="footer-pad" background-color="{{BRAND_FRAME}}" padding="28px 48px 20px" />
	<mj-class name="credit-pad" background-color="{{BRAND_FRAME}}" padding="0 48px 32px" />
	<mj-class name="body-card" background-color="{{BRAND_SURFACE}}" padding="36px 48px 48px" />
	<mj-class name="card-top" background-color="{{BRAND_SURFACE}}" padding="36px 48px 0" />
	<mj-class name="card-row" background-color="{{BRAND_SURFACE}}" padding="0 48px" />
	<mj-class name="card-bottom" background-color="{{BRAND_SURFACE}}" padding="0 48px 48px" />
	<mj-class name="footer-column" border-top="1px solid {{BRAND_RULE}}" padding-top="20px" />

	<mj-class name="logo-image" width="175px" padding="0 0 28px" />
	<mj-class name="accent-divider" border-color="{{BRAND_ACCENT}}" border-width="3px" padding="0" />

	<mj-class name="heading" font-family="{{BRAND_FONT_HEADING}}" font-size="22px" font-weight="400" color="{{BRAND_INK}}" line-height="1.3" align="left" />
	<mj-class name="date-text" font-size="10px" letter-spacing="0.05em" text-transform="uppercase" color="{{BRAND_MUTED}}" align="right" />
	<mj-class name="intro-text" font-size="13px" line-height="1.8" padding="0 0 32px" />
	<mj-class name="urgent-text" font-size="13px" line-height="1.8" align="center" padding="20px 0 0" />
	<mj-class name="field-divider" border-color="{{BRAND_FRAME}}" border-width="1px" padding="0 0 20px" />
	<mj-class name="field-label-text" color="{{BRAND_MUTED}}" font-size="9px" letter-spacing="0.12em" text-transform="uppercase" align="left" padding="14px 0" />
	<mj-class name="field-value-text" color="{{BRAND_INK}}" font-size="14px" line-height="1.7" align="left" padding="14px 0" />
	<mj-class name="message-label-text" color="{{BRAND_MUTED}}" font-size="9px" letter-spacing="0.12em" text-transform="uppercase" align="left" padding="0 0 4px" />
	<mj-class name="footer-name" align="center" font-size="11px" font-weight="bold" letter-spacing="0.2em" text-transform="uppercase" color="{{BRAND_INK}}" padding="0 0 6px" />
	<mj-class name="footer-text" align="center" font-size="11px" color="{{BRAND_MUTED}}" letter-spacing="0.05em" line-height="1.9" padding="0 0 6px" />
	<mj-class name="credit-text" align="center" font-size="10px" color="{{BRAND_CREDIT}}" letter-spacing="0.05em" />
	<mj-class name="cta-button" background-color="{{BRAND_INK}}" color="{{BRAND_FRAME}}" font-size="12px" font-weight="300" letter-spacing="0.1em" text-transform="uppercase" border-radius="0" align="center" padding="24px 0 0" inner-padding="14px 32px" />
</mj-attributes>

<mj-style inline="inline">
	.footer-link { color: {{BRAND_MUTED}}; text-decoration: none; }
	.credit-link { color: {{BRAND_CREDIT}}; text-decoration: none; font-weight: bold; }
	.urgent-link { color: {{BRAND_INK}}; font-weight: bold; text-decoration: underline; text-decoration-color: {{BRAND_ACCENT}}; }
	.message-quote { background: {{BRAND_FRAME}}; border-left: 3px solid {{BRAND_ACCENT}}; padding: 16px 20px; font-size: 14px; line-height: 1.7; color: {{BRAND_INK}}; }
</mj-style>

<mj-style>
	@media only screen and (max-width: 480px) {
		.page-frame > table > tbody > tr > td { padding: 24px !important; }
		.body-card > table > tbody > tr > td { padding: 28px 24px 32px !important; }
		.card-top > table > tbody > tr > td { padding: 28px 24px 0 !important; }
		.card-row > table > tbody > tr > td { padding: 0 24px !important; }
		.card-bottom > table > tbody > tr > td { padding: 0 24px 32px !important; }
		.footer-pad > table > tbody > tr > td { padding: 24px 24px 16px !important; }
		.credit-pad > table > tbody > tr > td { padding: 0 24px 24px !important; }
	}
</mj-style>

<mj-raw>
	<meta name="x-apple-disable-message-reformatting">
	<meta name="color-scheme" content="light">
	<meta name="supported-color-schemes" content="light">
	<meta name="format-detection" content="telephone=no, email=no, address=no">
</mj-raw>
