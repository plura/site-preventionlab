<!--
	Both halves of every row are runtime placeholders now: for a field named FIELD,
	%label_FIELD% is the form's own <label> text and %FIELD% is what was typed. The labels used
	to be written into this file in Portuguese, which meant renaming a field on the form left the
	email saying the old thing. To add a field, copy one row + divider pair and rename both
	placeholders; no submit.php change.

	Moved from _partials/ to contact/_partials/ because it is NOT shared - it is specific to the
	contact pair, unlike _head/_header/_footer/_credit, which every future template would reuse.
-->
<mj-section mj-class="card-row" css-class="card-row">
	<mj-column width="30%">
		<mj-text mj-class="field-label-text">%label_name%</mj-text>
	</mj-column>
	<mj-column width="70%">
		<mj-text mj-class="field-value-text">%name%</mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="card-row" css-class="card-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="card-row" css-class="card-row">
	<mj-column width="30%">
		<mj-text mj-class="field-label-text">%label_email%</mj-text>
	</mj-column>
	<mj-column width="70%">
		<mj-text mj-class="field-value-text">%email%</mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="card-row" css-class="card-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="card-row" css-class="card-row">
	<mj-column width="30%">
		<mj-text mj-class="field-label-text">%label_phone%</mj-text>
	</mj-column>
	<mj-column width="70%">
		<mj-text mj-class="field-value-text">%phone%</mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="card-row" css-class="card-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="card-row" css-class="card-row">
	<mj-column width="30%">
		<mj-text mj-class="field-label-text">%label_interest%</mj-text>
	</mj-column>
	<mj-column width="70%">
		<mj-text mj-class="field-value-text">%interest%</mj-text>
	</mj-column>
</mj-section>
<mj-section mj-class="card-row" css-class="card-row">
	<mj-column>
		<mj-divider mj-class="field-divider" />
	</mj-column>
</mj-section>

<mj-section mj-class="card-bottom" css-class="card-bottom">
	<mj-column>
		<mj-text mj-class="message-label-text">%label_message%</mj-text>
		<mj-raw><tr><td class="message-quote">%message%</td></tr></mj-raw>
	</mj-column>
</mj-section>
